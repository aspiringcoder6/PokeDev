{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.testing.agent/schemas/structured_test_case.schema.json",
  "title": "StructuredTestCase",
  "description": "Output schema of Test Design Agent representing an executable test case specification",
  "type": "object",
  "required": [
    "test_case_id",
    "function_id",
    "feature",
    "type",
    "priority",
    "steps",
    "expected_results"
  ],
  "properties": {
    "test_case_id": {
      "type": "string",
      "pattern": "^TC-[A-Z0-9_-]+$",
      "description": "Unique identifier for the test case (e.g. TC-USER-ADD-001)"
    },
    "function_id": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to the source function ID"
    },
    "feature": {
      "type": "string",
      "minLength": 1,
      "description": "Feature name"
    },
    "type": {
      "type": "string",
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "BOUNDARY",
        "VALIDATION",
        "CRUD",
        "PERMISSION"
      ],
      "description": "Classification of the test case"
    },
    "priority": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
      "default": "HIGH"
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "test_data": {
      "type": "object",
      "description": "Input values used for form filling or API parameters"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "action"],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "OPEN",
              "CLICK",
              "FILL",
              "SELECT",
              "UPLOAD",
              "SUBMIT",
              "WAIT",
              "ASSERT"
            ]
          },
          "target": {
            "type": "string",
            "description": "Target element label, role, text, or selector"
          },
          "value": {
            "type": "string",
            "description": "Value to input or assert"
          }
        },
        "additionalProperties": false
      }
    },
    "expected_results": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "List of expected functional outcomes"
    },
    "verification_strategy": {
      "type": "object",
      "properties": {
        "ui": { "type": "boolean", "default": true },
        "api": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "endpoint": { "type": "string" },
            "expected_status": { "type": "integer" }
          }
        },
        "db": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "query": { "type": "string" },
            "expected_count": { "type": "integer" }
          }
        }
      }
    },
    "source_rule": {
      "type": "object",
      "properties": {
        "rule_id": { "type": "string" },
        "kind": { "type": "string" },
        "field": { "type": ["string", "null"] },
        "constraint": { "type": "string" },
        "source_text": { "type": "string" }
      },
      "description": "Traceability metadata referencing machine rule from Internal Test Context"
    }
  },
  "additionalProperties": false
}
