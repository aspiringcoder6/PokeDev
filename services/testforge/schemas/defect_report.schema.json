{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.testing.agent/schemas/defect_report.schema.json",
  "title": "DefectReport",
  "description": "Defect report schema emitted when an application bug/defect is identified",
  "type": "object",
  "required": [
    "defect_id",
    "function_id",
    "test_case_id",
    "expected",
    "actual",
    "classification",
    "severity",
    "evidence",
    "created_at"
  ],
  "properties": {
    "defect_id": {
      "type": "string",
      "pattern": "^DEFECT-[A-Z0-9_-]+$",
      "description": "Unique identifier for the defect"
    },
    "function_id": {
      "type": "string",
      "description": "Related function ID"
    },
    "test_case_id": {
      "type": "string",
      "description": "Test case ID that exposed the defect"
    },
    "expected": {
      "type": "string",
      "description": "Business expected outcome"
    },
    "actual": {
      "type": "string",
      "description": "Actual observed outcome / error"
    },
    "classification": {
      "type": "string",
      "const": "APPLICATION_DEFECT"
    },
    "severity": {
      "type": "string",
      "enum": ["BLOCKER", "CRITICAL", "HIGH", "MEDIUM", "LOW"],
      "default": "HIGH"
    },
    "reproduction_steps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Sequential steps to reproduce the bug"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to artifacts proving the bug (screenshots, traces, logs)"
    },
    "environment": {
      "type": "string",
      "description": "Target environment where defect occurred (e.g. staging, dev)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
