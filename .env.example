# PokeDev local development. Copy to .env; configure this fork independently.
LANGFLOW_HOST=127.0.0.1
LANGFLOW_PORT=7862
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_DATABASE_URL=sqlite:///./data/pokedev.db
LANGFLOW_SUPERUSER=pokedev
LANGFLOW_SUPERUSER_PASSWORD=
LANGFLOW_SECRET_KEY=
LANGFLOW_CORS_ORIGINS=["http://127.0.0.1:7862","http://localhost:7862","http://localhost:3000","http://127.0.0.1:3000"]
DO_NOT_TRACK=true
LANGFLOW_DO_NOT_TRACK=true
BACKEND_URL=http://127.0.0.1:7862
ADLC_SUBTASK_GENERATION_MODE=mock
ADLC_OPENCODE_ENABLED=false
ADLC_HARNESS_ENABLED=false
ADLC_HARNESS_DEMO_ENABLED=false
ADLC_DEMO_GITHUB_ENABLED=false
ADLC_DEMO_WEBHOOK_AUTO_PLAN=false

# Configure a dedicated Harness only when enabling real agent execution.
VAI_PLATFORM_URL=
VAI_PLATFORM_TOKEN=
ADLC_BLUEPRINT_DSH_TOKEN=
ADLC_HARNESS_BASE_URL=http://127.0.0.1:3082
POKEDEV_HARNESS_PROVIDER=
POKEDEV_HARNESS_MODEL=
# Optional absolute project repository path (use forward slashes on Windows).
POKEDEV_PROJECT_REPO=
POKEDEV_TESTFORGE_TARGET_URL=http://127.0.0.1:7862/work
VAI_GITEA_TOKEN=
ADLC_HARNESS_API_TOKEN=
ADLC_HARNESS_CALLBACK_SECRET=

# Generated by `python deploy/local/stack.py init`. Do not commit .env.
POKEDEV_DB_PASSWORD=
POKEDEV_MEMORY_PASSWORD=
ADLC_SANDBOX_BROKER_TOKEN=
OPENSANDBOX_API_KEY=
TESTFORGE_BROKER_TOKEN=

# Legacy connectors are retained for migration and point only to local addresses.
# They are not the new PokeDev control plane and are not provisioned by this fork.
VAI_WORKLOOP_URL=http://127.0.0.1:18903
VAI_WORKLOOP_MCP_URL=http://127.0.0.1:18107/mcp
VAI_SLACK_APP_ID=
VAI_SLACK_TEAM_ID=

ADLC_SOURCE_BINDINGS_FILE=
ADLC_SOURCE_MAX_READS=24
ADLC_SOURCE_MAX_BYTES=500000

ADLC_REQUIREMENT_READINESS_ENABLED=false
ADLC_CONTEXT_MAX_ROUNDS=3
ADLC_READINESS_STORE_PATH=./data/requirement-readiness.sqlite3
ADLC_READINESS_SERVICE_BINDINGS_FILE=
ADLC_READINESS_NATIVE_MANIFEST=
ADLC_READINESS_HUMAN_GATE_POLICY_FILE=
