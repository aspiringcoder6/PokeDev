  "package_id": "coding-agent",
  "version": "0.3.0",
  "name": "Coding Agent",
  "description": "Selected-project Coding Agent with explicit Harness or OpenCode iteration runtime and kernel-owned verification.",
  "interface": {
    "inputs": [
      {
        "name": "requirement",
        "schema_ref": "adlc://schemas/requirement/0.1",
        "required": true,
        "multiple": false,
        "description": "The scoped implementation requirement."
      },
      {
        "name": "task_loop_spec",
        "schema_ref": "adlc://schemas/task-loop-spec/0.2",
        "required": false,
        "multiple": false,
        "description": "Pinned base commit, complete specification, writable files, acceptance checks, and loop budgets."
      }
    ],
    "outputs": [
      {
        "name": "source_patch",
        "schema_ref": "adlc://schemas/source-patch/0.1",
        "required": true,
        "multiple": false,
        "description": "Publisher-owned reference to the captured local Git diff."
      },
      {
        "name": "contract_reference",
        "schema_ref": "adlc://schemas/contract-reference/0.1",
        "required": false,
        "multiple": false
      },
      {
        "name": "candidate",
        "schema_ref": "adlc://schemas/task-loop-candidate/0.2",
        "required": false,
        "multiple": false,
        "description": "Checksummed cumulative UTF-8 overlay on the pinned base."
      },
      {
        "name": "verification_report",
        "schema_ref": "adlc://schemas/task-loop-verification/0.2",
        "required": false,
        "multiple": false,
        "description": "Real protected unittest command results tied to the exact candidate."
      },
      {
        "name": "contract_verification_report",
        "schema_ref": "adlc://schemas/coding-agent-contract-verification/0.1",
        "required": false,
        "multiple": false,
        "description": "Kernel-owned contract checks bound to the verified loop candidate."
      }
    ]
  },
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "approved_contract_ref": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "schema_ref",
          "contract_id",
          "revision",
          "content_digest"
        ],
        "properties": {
          "schema_ref": {
            "const": "adlc://schemas/skilltree-contract/0.1"
          },
          "contract_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "task_loop_enabled": {
        "type": "boolean",
        "description": "Repeat fresh implementation sessions until the supplied task loop checks pass."
      },
      "submission_mode": {
        "type": "string",
        "enum": [
          "AUTO",
          "MANUAL"
        ]
      },
      "loop_runtime": {
        "type": "string",
        "enum": [
          "HARNESS",
          "OPENCODE"
        ],
        "description": "Runtime for new task loops; does not reroute accepted plans."
      }
    }
  },
  "defaults": {
    "approved_contract_ref": null,
    "task_loop_enabled": false,
    "submission_mode": "MANUAL",
    "loop_runtime": "HARNESS"
  },
