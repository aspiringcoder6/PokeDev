{
  "schema_version": "0.1",
  "package_id": "skilltree-authoring-deepseek-harness",
  "version": "0.1.0",
  "status": "PUBLISHED",
  "name": "Skilltree Contract Author (six tools)",
  "description": "Authors one roadmap through the ADLC writer. Read-only shared viewer; human contract approval and execution are separate.",
  "kind": "AGENT",
  "interface": {
    "inputs": [
      {
        "name": "requirement",
        "schema_ref": "adlc://schemas/requirement/0.1",
        "required": true,
        "multiple": false,
        "description": "Objective, scope and acceptance requirements for the roadmap."
      }
    ],
    "outputs": [
      {
        "name": "contract_reference",
        "schema_ref": "adlc://schemas/contract-reference/0.1",
        "required": true,
        "multiple": false,
        "description": "Writer-owned exact reference to a validated roadmap; not proof of approval/execution."
      }
    ]
  },
