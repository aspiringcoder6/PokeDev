{
  "schema_version": "0.1",
  "package_id": "coding-agent-deepseek-harness",
  "version": "0.3.1",
  "status": "PUBLISHED",
  "name": "Coding Agent (Harness + captured Git patch)",
  "description": "Runs in an isolated committed Git snapshot, including Windows Docker bind mounts, and publishes a bounded, checksummed source patch for ADLC review.",
  "kind": "AGENT",
  "interface": {
    "inputs": [
      {
        "name": "requirement",
        "schema_ref": "adlc://schemas/requirement/0.1",
        "required": true,
        "multiple": false,
        "description": "The scoped implementation requirement."
      }
    ],
    "outputs": [
      {
        "name": "source_patch",
        "schema_ref": "adlc://schemas/source-patch/0.1",
        "required": true,
        "multiple": false,
        "description": "Publisher-owned reference to the captured local Git diff."
      }
    ]
  },
  "configuration_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "harness_profile_ref",
      "result_schema_ref",
      "submission_mode",
      "callback_ref",
      "plugin_lock"
    ],
    "properties": {
      "harness_profile_ref": {
        "const": "harness-profile:adlc-coding-artifacts/0.1.0"
      },
      "result_schema_ref": {
        "const": "adlc://schemas/source-patch/0.1"
      },
      "submission_mode": {
        "type": "string",
        "enum": [
          "AUTO",
          "MANUAL"
        ]
      },
      "callback_ref": {
        "const": "adlc-primary"
      },
      "plugin_lock": {
        "const": [
          {
            "plugin_id": "vai-adlc-driver-deepseek",
            "version": "0.2.0",
            "content_digest": "sha256:fd008789399cf9ce4770281e0b955c38a45dbd7e863425fdac82a35c806a5a63",
            "required": true
          },
          {
            "plugin_id": "vai-adlc-runtime",
            "version": "0.3.0",
            "content_digest": "sha256:0739d9e137ece1ebd6c5b97264b39100b4f56b466a7a5b2c18f1e18233f8b6e7",
            "required": true
          },
          {
            "plugin_id": "vai-adlc-verify-structured",
            "version": "0.1.0",
            "content_digest": "sha256:e0c50d273c1b9b8f29679a0d5e0f213cef926d5ff057850a3e0da9f039a3a843",
            "required": true
          },
          {
            "plugin_id": "vai-adlc-artifacts-git",
            "version": "0.1.1",
            "content_digest": "sha256:479b28aaa3137c6db9191e45d11dd8013d2b7a969228d231b5346ca5b6ee77ec",
            "required": true
          }
        ]
      }
    }
  },
  "defaults": {
    "harness_profile_ref": "harness-profile:adlc-coding-artifacts/0.1.0",
    "result_schema_ref": "adlc://schemas/source-patch/0.1",
    "submission_mode": "MANUAL",
    "callback_ref": "adlc-primary",
    "plugin_lock": [
      {
        "plugin_id": "vai-adlc-driver-deepseek",
        "version": "0.2.0",
        "content_digest": "sha256:fd008789399cf9ce4770281e0b955c38a45dbd7e863425fdac82a35c806a5a63",
        "required": true
      },
      {
        "plugin_id": "vai-adlc-runtime",
        "version": "0.3.0",
        "content_digest": "sha256:0739d9e137ece1ebd6c5b97264b39100b4f56b466a7a5b2c18f1e18233f8b6e7",
        "required": true
      },
      {
        "plugin_id": "vai-adlc-verify-structured",
        "version": "0.1.0",
        "content_digest": "sha256:e0c50d273c1b9b8f29679a0d5e0f213cef926d5ff057850a3e0da9f039a3a843",
        "required": true
      },
      {
        "plugin_id": "vai-adlc-artifacts-git",
        "version": "0.1.1",
        "content_digest": "sha256:479b28aaa3137c6db9191e45d11dd8013d2b7a969228d231b5346ca5b6ee77ec",
        "required": true
      }
    ]
  },
  "override_allowlist": [
    "/configuration/submission_mode",
    "/policies/timeout_ms"
  ],
  "implementation": {
    "adapter_type": "AGENT_PROVIDER",
    "adapter_ref": "agent-provider:deepseek-harness",
    "entrypoint": "coding-task"
  },
  "execution_profile": {
    "provider_ref": "agent-provider:deepseek-harness",
    "model_ref": "model:deepseek-harness/configured",
    "system_prompt_ref": "prompt:deepseek-harness-coding-agent/0.1.0",
    "rule_set_refs": [
      "rules:adlc-safe-execution/0.1.0"
    ],
    "hook_refs": [
      "hook:task-lifecycle/0.1.0"
    ],
    "capabilities": {
      "tool_refs": [
        "tool:deepseek-harness-default"
      ],
      "skill_refs": [],
      "plugin_refs": [
        "plugin:vai-adlc-driver-deepseek/0.2.0",
        "plugin:vai-adlc-runtime/0.3.0",
        "plugin:vai-adlc-verify-structured/0.1.0",
        "plugin:vai-adlc-artifacts-git/0.1.1"
      ],
      "mcp_server_refs": []
    },
    "memory_policy_ref": "memory:dsh-session/0.1.0",
    "sandbox_policy_ref": "sandbox:harness-isolated-git/0.1.0",
    "secret_refs": {}
  },
  "default_policies": {
    "retry": {
      "max_attempts": 1
    },
    "timeout_ms": 900000,
    "approval": {
      "gate_type": null
    },
    "permissions": {
      "mode": "PACKAGE_ALLOWLIST"
    },
    "resources": {
      "runtime": "deepseek-harness",
      "result_delivery": "signed-webhook",
      "verification": "plugin",
      "plugin_integrity": "required",
      "artifact_capture": "isolated-git-diff"
    },
    "runtime_overridable": [
      "/policies/timeout_ms"
    ]
  },
  "compatibility": {
    "engine": {
      "minimum_version": "0.1.0"
    },
    "execution_contract_versions": [
      "0.1"
    ]
  },
  "metadata": {
    "activation": "opt-in",
    "maintainer": "adlc",
    "milestone": "H4A",
    "provider_mode": "deepseek-harness",
    "verification_mode": "structured-only",
    "submission_mode": "manual-by-default",
    "artifact_mode": "captured-git-patch",
    "hotfix": "scoped-git-source-transport"
  }
}
