{
  "$defs": {
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected"
        },
        "found": {
          "title": "Found",
          "type": "boolean"
        },
        "observed": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "pointer",
        "expected",
        "observed",
        "found",
        "passed"
      ],
      "title": "Comparison",
      "type": "object"
    }
  },
  "$id": "https://adlc.dev/contracts/verification/v0.1/verification-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Comparison"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "comparator_ref": {
      "const": "validator:json-fixture/0.1.0",
      "default": "validator:json-fixture/0.1.0",
      "title": "Comparator Ref",
      "type": "string"
    },
    "contract_fully_verified": {
      "const": false,
      "default": false,
      "title": "Contract Fully Verified",
      "type": "boolean"
    },
    "natural_language_enforced": {
      "const": false,
      "default": false,
      "title": "Natural Language Enforced",
      "type": "boolean"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "receipt_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receipt Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "plan_digest",
    "receipt_digest",
    "candidate_digest",
    "verdict",
    "checks"
  ],
  "title": "VerificationReport",
  "type": "object"
}
