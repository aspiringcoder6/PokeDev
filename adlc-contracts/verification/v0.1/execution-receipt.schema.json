{
  "$defs": {
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "found": {
          "title": "Found",
          "type": "boolean"
        },
        "observed": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "pointer",
        "found",
        "observed"
      ],
      "title": "Observation",
      "type": "object"
    }
  },
  "$id": "https://adlc.dev/contracts/verification/v0.1/execution-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "completion_mode": {
      "default": "process-exit",
      "enum": [
        "process-exit",
        "durable-checkpoint"
      ],
      "title": "Completion Mode",
      "type": "string"
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exit Code"
    },
    "image_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Ref"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "maxItems": 16,
      "title": "Observations",
      "type": "array"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "provider": {
      "enum": [
        "local-fixture",
        "sandbox-kit"
      ],
      "title": "Provider",
      "type": "string"
    },
    "runner_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Runner Digest",
      "type": "string"
    },
    "runner_ref": {
      "const": "runner:adlc-json-fixture/0.1.0",
      "default": "runner:adlc-json-fixture/0.1.0",
      "title": "Runner Ref",
      "type": "string"
    },
    "sandbox_session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sandbox Session Id"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "tests_run": {
      "maximum": 16,
      "minimum": 0,
      "title": "Tests Run",
      "type": "integer"
    }
  },
  "required": [
    "execution_id",
    "plan_digest",
    "candidate_digest",
    "runner_digest",
    "provider",
    "tests_run",
    "exit_code",
    "observations",
    "started_at",
    "completed_at"
  ],
  "title": "ExecutionReceipt",
  "type": "object"
}
