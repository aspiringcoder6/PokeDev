{
  "$defs": {
    "LiveLoopCommand": {
      "additionalProperties": false,
      "description": "A registered runner, not an agent-generated shell command.",
      "properties": {
        "check_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Check Id",
          "type": "string"
        },
        "test_path": {
          "title": "Test Path",
          "type": "string"
        },
        "timeout_ms": {
          "default": 30000,
          "maximum": 120000,
          "minimum": 100,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "verifier_ref": {
          "const": "verifier:python-unittest/0.1.0",
          "default": "verifier:python-unittest/0.1.0",
          "title": "Verifier Ref",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "test_path"
      ],
      "title": "LiveLoopCommand",
      "type": "object"
    },
    "LiveLoopCriterion": {
      "additionalProperties": false,
      "properties": {
        "check_refs": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Check Refs",
          "type": "array"
        },
        "criterion_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "description",
        "check_refs"
      ],
      "title": "LiveLoopCriterion",
      "type": "object"
    }
  },
  "$id": "https://adlc.dev/contracts/task-loop/v0.2/task-loop-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "items": {
        "$ref": "#/$defs/LiveLoopCriterion"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "base_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Base Commit",
      "type": "string"
    },
    "context_budget_chars": {
      "default": 131072,
      "maximum": 262144,
      "minimum": 1024,
      "title": "Context Budget Chars",
      "type": "integer"
    },
    "max_duration_ms": {
      "default": 600000,
      "maximum": 3600000,
      "minimum": 1000,
      "title": "Max Duration Ms",
      "type": "integer"
    },
    "max_iterations": {
      "default": 3,
      "maximum": 100,
      "minimum": 1,
      "title": "Max Iterations",
      "type": "integer"
    },
    "max_stalled_iterations": {
      "default": 2,
      "maximum": 100,
      "minimum": 1,
      "title": "Max Stalled Iterations",
      "type": "integer"
    },
    "max_total_cost": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Total Cost"
    },
    "max_total_tokens": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Total Tokens"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_id": {
      "format": "uuid",
      "title": "Spec Id",
      "type": "string"
    },
    "specification": {
      "maxLength": 16384,
      "minLength": 1,
      "title": "Specification",
      "type": "string"
    },
    "verification_commands": {
      "items": {
        "$ref": "#/$defs/LiveLoopCommand"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Verification Commands",
      "type": "array"
    },
    "writable_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Writable Paths",
      "type": "array"
    }
  },
  "required": [
    "spec_id",
    "specification",
    "base_commit",
    "writable_paths",
    "acceptance_criteria",
    "verification_commands"
  ],
  "title": "LiveLoopSpec",
  "type": "object"
}
