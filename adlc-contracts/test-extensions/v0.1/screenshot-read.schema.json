{
  "$id": "https://adlc.dev/contracts/test-extensions/v0.1/screenshot-read.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affects_verdict": {
      "const": false,
      "default": false,
      "title": "Affects Verdict",
      "type": "boolean"
    },
    "attachment_id": {
      "format": "uuid",
      "title": "Attachment Id",
      "type": "string"
    },
    "authority": {
      "const": "SUPPLEMENTARY_UNTRUSTED",
      "default": "SUPPLEMENTARY_UNTRUSTED",
      "title": "Authority",
      "type": "string"
    },
    "byte_size": {
      "maximum": 262144,
      "minimum": 1,
      "title": "Byte Size",
      "type": "integer"
    },
    "candidate_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "caption": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Caption",
      "type": "string"
    },
    "capture_provenance_verified": {
      "const": false,
      "default": false,
      "title": "Capture Provenance Verified",
      "type": "boolean"
    },
    "case_evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Case Evidence Digest",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "height": {
      "maximum": 4096,
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "input_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "media_type": {
      "const": "image/png",
      "default": "image/png",
      "title": "Media Type",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "profile_ref": {
      "const": "evidence-profile:supplementary-png/0.1.0",
      "default": "evidence-profile:supplementary-png/0.1.0",
      "title": "Profile Ref",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "uploaded_at": {
      "format": "date-time",
      "title": "Uploaded At",
      "type": "string"
    },
    "uploaded_by": {
      "title": "Uploaded By",
      "type": "string"
    },
    "width": {
      "maximum": 4096,
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    },
    "workflow_run_id": {
      "format": "uuid",
      "title": "Workflow Run Id",
      "type": "string"
    }
  },
  "required": [
    "attachment_id",
    "workflow_run_id",
    "plan_id",
    "plan_digest",
    "execution_id",
    "candidate_digest",
    "case_id",
    "caption",
    "uploaded_by",
    "uploaded_at",
    "input_digest",
    "content_digest",
    "byte_size",
    "width",
    "height",
    "case_evidence_digest"
  ],
  "title": "ScreenshotRead",
  "type": "object"
}
