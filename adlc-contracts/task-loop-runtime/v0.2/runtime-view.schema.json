{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.dev/contracts/task-loop-runtime/v0.2/runtime-view.schema.json",
  "$defs": {
    "LoopRuntimeBindingV2": {
      "additionalProperties": false,
      "properties": {
        "protocol_ref": {
          "const": "task-loop-runtime:iteration/0.2.0",
          "default": "task-loop-runtime:iteration/0.2.0",
          "title": "Protocol Ref",
          "type": "string"
        },
        "runtime_ref": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./:-]+$",
          "title": "Runtime Ref",
          "type": "string"
        },
        "family": {
          "enum": [
            "OPENCODE",
            "HARNESS",
            "CUSTOM"
          ],
          "title": "Family",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./:-]+$",
          "title": "Provider Id",
          "type": "string"
        },
        "model_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./:-]+$",
          "title": "Model Id",
          "type": "string"
        },
        "agent": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_./:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "modes": {
          "items": {
            "enum": [
              "WORKSPACE_EDIT",
              "FILE_PROPOSAL"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        },
        "fresh_sessions": {
          "const": true,
          "default": true,
          "title": "Fresh Sessions",
          "type": "boolean"
        },
        "reported_usage": {
          "const": true,
          "default": true,
          "title": "Reported Usage",
          "type": "boolean"
        },
        "cancellation": {
          "const": true,
          "default": true,
          "title": "Cancellation",
          "type": "boolean"
        },
        "cost_reporting": {
          "const": "UNAVAILABLE",
          "default": "UNAVAILABLE",
          "title": "Cost Reporting",
          "type": "string"
        }
      },
      "required": [
        "runtime_ref",
        "family",
        "provider_id",
        "model_id",
        "modes"
      ],
      "title": "LoopRuntimeBindingV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "workflow_run_id": {
      "format": "uuid",
      "title": "Workflow Run Id",
      "type": "string"
    },
    "task_run_id": {
      "format": "uuid",
      "title": "Task Run Id",
      "type": "string"
    },
    "binding_source": {
      "enum": [
        "CHECKPOINT",
        "LEGACY",
        "NOT_STARTED",
        "UNAVAILABLE"
      ],
      "title": "Binding Source",
      "type": "string"
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/LoopRuntimeBindingV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "protocol_ref": {
      "anyOf": [
        {
          "const": "task-loop-runtime:iteration/0.2.0",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Protocol Ref"
    },
    "execution_unified_with_harness": {
      "const": false,
      "default": false,
      "title": "Execution Unified With Harness",
      "type": "boolean"
    }
  },
  "required": [
    "workflow_run_id",
    "task_run_id",
    "binding_source"
  ],
  "title": "LoopRuntimeViewV2",
  "type": "object"
}
