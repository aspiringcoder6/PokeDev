{
  "$defs": {
    "ReplayObservation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "found": {
          "title": "Found",
          "type": "boolean"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        },
        "observed": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        },
        "response_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Response Digest",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "pointer",
        "found",
        "observed",
        "http_status",
        "response_digest",
        "outcome"
      ],
      "title": "ReplayObservation",
      "type": "object"
    }
  },
  "$id": "https://adlc.dev/contracts/verification-replay/v0.1/replay-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "completion_mode": {
      "enum": [
        "process-exit",
        "durable-checkpoint"
      ],
      "title": "Completion Mode",
      "type": "string"
    },
    "config_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Config Digest",
      "type": "string"
    },
    "credential_ref": {
      "const": "credential-profile:ephemeral-fixture/0.1.0",
      "title": "Credential Ref",
      "type": "string"
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exit Code"
    },
    "heal": {
      "const": false,
      "title": "Heal",
      "type": "boolean"
    },
    "junit_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Junit Digest",
      "type": "string"
    },
    "junit_xml": {
      "maxLength": 32768,
      "title": "Junit Xml",
      "type": "string"
    },
    "models_used": {
      "const": false,
      "title": "Models Used",
      "type": "boolean"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ReplayObservation"
      },
      "maxItems": 16,
      "title": "Observations",
      "type": "array"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "provider": {
      "const": "local-http-fixture",
      "title": "Provider",
      "type": "string"
    },
    "runner_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Runner Digest",
      "type": "string"
    },
    "runner_ref": {
      "const": "runner:adlc-http-json-replay/0.1.0",
      "title": "Runner Ref",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "suite_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Suite Digest",
      "type": "string"
    },
    "target_instance_id": {
      "format": "uuid",
      "title": "Target Instance Id",
      "type": "string"
    },
    "target_origin": {
      "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}$",
      "title": "Target Origin",
      "type": "string"
    },
    "target_profile_ref": {
      "const": "target-profile:disposable-http-json/0.1.0",
      "title": "Target Profile Ref",
      "type": "string"
    },
    "target_released": {
      "const": true,
      "title": "Target Released",
      "type": "boolean"
    },
    "tests_run": {
      "maximum": 16,
      "minimum": 0,
      "title": "Tests Run",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "execution_id",
    "plan_digest",
    "candidate_digest",
    "suite_digest",
    "config_digest",
    "runner_ref",
    "runner_digest",
    "provider",
    "target_profile_ref",
    "credential_ref",
    "target_instance_id",
    "target_origin",
    "target_released",
    "heal",
    "models_used",
    "tests_run",
    "completion_mode",
    "exit_code",
    "observations",
    "junit_xml",
    "junit_digest",
    "started_at",
    "completed_at"
  ],
  "title": "ReplayReceipt",
  "type": "object"
}
